#!/usr/bin/env bash
# Usage: mine-zec N. Mines N regtest blocks on Zebra; coinbase goes to mining.miner_address.
set -euo pipefail

body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"generate\",\"params\":[${1:?usage: mine-zec N}]}"

# Right after start Zebra answers "state is empty" (HTTP 200) until genesis is committed.
for _ in $(seq 30); do
    out="$(curl -sS --retry 30 --retry-connrefused --retry-delay 1 \
        -H 'content-type: application/json' --data "$body" http://127.0.0.1:18232)"
    if [[ "$out" == *'"result"'* ]]; then
        echo "$out"
        exit 0
    fi
    sleep 1
done
echo "mine-zec: $out" >&2
exit 1
